# OMG environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit your key.
#   cp .env.example .env
# Scripts (scripts/reproduce.sh, `make smoke-synth`) auto-load `.env`.
# To load it into your own shell:  set -a; source .env; set +a

# --- Weights & Biases -------------------------------------------------------
# Get your key from https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_MODE=online          # online | offline | disabled
WANDB_PROJECT=omg          # overrides logger config project name
# WANDB_ENTITY=your-team   # uncomment to log to a team/org

# --- Data and model roots (set when OMG-Data / checkpoints are downloaded) ---
OMG_DATA_ROOT=data/OMG-Data
OMG_MATERIALIZED_ROOT=data/OMG-Data/materialized
OMG_MODELS_ROOT=models
# T5-3B encoder used by text retrieval benchmarks (optional, offline path)
# OMG_T5_3B_MODEL=models/t5-3b-local

# --- Runtime ----------------------------------------------------------------
PYTHONPATH=src
TOKENIZERS_PARALLELISM=false
CUDA_VISIBLE_DEVICES=0,1,2,3
# Offline HF if encoders are pre-cached and the box has no network:
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
